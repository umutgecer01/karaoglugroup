{
  "name": "karaoglu-grup-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "sync:site": "node scripts/sync-site-metadata.mjs",
    "prebuild": "npm run sync:site",
    "build": "vite build && node scripts/prerender.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test scripts/core.test.mjs scripts/sync-preview.test.mjs scripts/forms-readiness.test.mjs scripts/motion-preference.test.mjs scripts/production-policy.test.mjs",
    "sync:preview": "node scripts/sync-preview.mjs",
    "lint:security": "eslint src eslint.config.js vite.config.js tailwind.config.js postcss.config.js --max-warnings=0",
    "security:audit": "npm audit --audit-level=moderate",
    "security:check": "npm run security:audit && npm run lint:security"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^8.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.6.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-security": "^4.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17"
  },
  "overrides": {
    "eslint": {
      "minimatch": "11.0.1"
    },
    "@eslint/config-array": {
      "minimatch": "11.0.1"
    }
  }
}
